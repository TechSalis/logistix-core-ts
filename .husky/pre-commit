npx lint-staged || exit $?

# Type check if TypeScript files changed
staged=$(git diff --staged --name-only | grep -E '\.ts$' || true)
if [ -n "$staged" ]; then
  npx --no-install tsc --noEmit || exit $?
fi

# Rebuild dist as a build smoke test using the FULL build (dist is committed
# and must include the contracts surface for git-pinned consumers).
npm run build || exit $?
